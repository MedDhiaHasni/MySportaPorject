rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isConversationParticipant(conversationId) {
      let conversationPath = /databases/$(database)/documents/conversations/$(conversationId);
      return isSignedIn()
        && exists(conversationPath)
        && request.auth.uid in get(conversationPath).data.participants;
    }

    match /conversations/{conversationId} {
      allow get, list: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      // Conversations and participant membership are provisioned by Strapi.
      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt'])
        && (request.resource.data.lastMessage == null
          || request.resource.data.lastMessage is string)
        && (request.resource.data.lastMessageAt == null
          || request.resource.data.lastMessageAt is timestamp);

      allow delete: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && resource.data.type != 'worker_manager';

      match /messages/{messageId} {
        allow get, list: if isConversationParticipant(conversationId);

        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.keys().hasAll([
            'text', 'senderId', 'type', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'text', 'senderId', 'type', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.type is string
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        allow delete: if isConversationParticipant(conversationId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
