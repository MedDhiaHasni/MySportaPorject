      "type": "decimal",
      "required": true,
      "min": 0.5,
      "max": 5
    },
    "player": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player.player",
      "inversedBy": "ratings"
    },
    "venue": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::venue.venue",
      "inversedBy": "ratings"
    }   
  }
}