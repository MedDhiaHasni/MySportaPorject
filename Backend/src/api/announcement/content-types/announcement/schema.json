{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": {
    "singularName": "announcement",
    "pluralName": "announcements",
    "displayName": "announcement"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "description": {
      "type": "text",
      "required": true
    },
    "players_needed": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "status": {
      "type": "enumeration",
      "enum": ["open", "full", "closed"],
      "default": "open",
      "required": true
    },
    "reservation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::reservation.reservation"
    },
    "player": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player.player",
      "inversedBy": "announcements"
    },
    "join_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::join-request.join-request",
      "mappedBy": "announcement"
    }
  }
}