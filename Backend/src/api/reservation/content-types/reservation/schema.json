{
  "kind": "collectionType",
  "collectionName": "reservations",
  "info": {
    "singularName": "reservation",
    "pluralName": "reservations",
    "displayName": "reservation"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "booking_reference": { "type": "string", "required": true },
    "booking_date":      { "type": "datetime", "required": true },
    "booking_date_play": { "type": "date", "required": true },
    "start_time":        { "type": "time" },
    "end_time":          { "type": "time" },
    "duration_hours":    { "type": "decimal", "required": true },
    "total_price":       { "type": "decimal", "required": true },
    "special_requests":  { "type": "text" },
    "needed_players":    { "type": "integer" },

    "payment_method": {
      "type": "enumeration",
      "required": true,
      "enum": ["pay_now", "pay_at_venue"]
    },

    "booking_status": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "pending",
        "confirmed",
        "cancel_requested",
        "cancelled",
        "completed",
        "rejected"
      ]
    },

    "cancellation_reason": {
      "type": "string",
      "maxLength": 500
    },

    "rejection_reason": {
      "type": "string",
      "maxLength": 500
    },

    "court": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::court.court",
      "inversedBy": "reservations"
    },
    "player": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player.player",
      "inversedBy": "reservations"
    },
    "manager": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::manager.manager",
      "inversedBy": "reservations"
    },
    "time_slot": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::time-slot.time-slot",
      "inversedBy": "reservation"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "reservation"
    }
  }
}