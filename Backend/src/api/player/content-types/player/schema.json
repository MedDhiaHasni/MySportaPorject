{
  "kind": "collectionType",
  "collectionName": "players",
  "info": {
    "singularName": "player",
    "pluralName": "players",
    "displayName": "player"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "phone": {
      "type": "string"
    },
    "player": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "reservations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reservation.reservation",
      "mappedBy": "player"
    },
    "ratings": {
    "type": "relation",
    "relation": "oneToMany",
    "target": "api::rating.rating",
    "mappedBy": "player"
    },
    "announcements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::announcement.announcement",
      "mappedBy": "player"
    },
    "join_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::join-request.join-request",
      "mappedBy": "player"
    },
    "firebaseUid": {
      "type": "string"
    },
    "fcmToken": {
      "type": "string"
    },
    "nom": {
      "type": "string"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
